# HTTP server
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# PostgreSQL; required for the database-backed API. Use a TLS connection string in hosted environments.
DATABASE_URL=postgres://khanfem:change-me@localhost:5432/khanfem
PGSSLMODE=disable
# Integration tests require a separate disposable database; never point this at production.
TEST_DATABASE_URL=postgres://khanfem:change-me@localhost:5432/khanfem_test

# Session cookies: for public HTTPS/embedded preview set secure=true and samesite=none.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_DAYS=7

# First-owner setup only: provide these temporarily when running npm run db:bootstrap-admin.
# Do not commit a populated .env file or put real values in this example.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Existing optional integrations. Maps key must remain server-side.
COURIER_PHONE=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Optional provider integrations. Online payment and external messages stay disabled unless configured.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
